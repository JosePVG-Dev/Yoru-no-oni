# Unity YAML text assets - use text diff/merge, NOT LFS
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.overrideController text
*.physicMaterial text
*.physicMaterial2D text
*.mixer text
*.playable text
*.inputactions text
*.preset text
*.mask text
*.brush text
*.terrainlayer text
*.flare text
*.lighting text
*.cubemap text
*.renderTexture text
*.fontsettings text
*.guiskin text
*.signal text

# Meta files - text
*.meta text

